<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Local development only: allows plain HTTP (cleartext) to the
        machine running the EchoPanel backend during development.
        Production builds should point BACKEND_BASE_URL at an https://
        endpoint and can remove this override entirely.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator's alias for the host machine's localhost -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Your dev machine's LAN IP when testing on a physical device.
             Update this if your machine's IP changes (e.g. new Wi-Fi network). -->
        <domain includeSubdomains="false">192.168.1.9</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
