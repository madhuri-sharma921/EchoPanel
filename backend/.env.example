ENVIRONMENT=development

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Agora Conversational AI Engine (https://console.agora.io)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
AGORA_WEBHOOK_SECRET=

# Publicly reachable URL for THIS backend, so Agora's cloud agent can call
# back into /v1/chat/completions. A LAN address (192.168.x.x) will NOT
# work — Agora's servers can't reach your local network. Use a tunnel
# (e.g. `ngrok http 8000`) during development and paste its https URL here.
PUBLIC_BACKEND_URL=

VAGUENESS_CONFIDENCE_THRESHOLD=0.4
CORS_ALLOW_ORIGINS=["*"]
